# Copy to .env and fill in. Names only; never commit real values.
# Gemini: a personal Google AI Studio key. Never a work account, never Vertex AI / ADC.
GEMINI_API_KEY=
TEPHRA_LLM=stub                      # stub (offline, labelled NO MODEL) | gemini
TEPHRA_MODEL=gemini-3.8-flash        # Plume Reader
TEPHRA_MODEL_LITE=gemini-3.5-flash-lite
TEPHRA_MODEL_DAILY_BUDGET=18         # free tier is reported at ~20 requests/day
TEPHRA_MODEL_LITE_DAILY_BUDGET=450

# Desk and scheduler auth
TEPHRA_DESK_PIN=
TEPHRA_SESSION_SECRET=
TEPHRA_TASK_TOKEN=

# Storage: sqlite locally; firestore only inside Cloud Run (runtime service account)
TEPHRA_STORE=sqlite
TEPHRA_GCP_PROJECT=
TEPHRA_GCS_BUCKET=

# Run mode
TEPHRA_MODE=LIVE                     # LIVE | REPLAY
TEPHRA_REPLAY_CASE=
TEPHRA_AUTO_REPLAY=false
TEPHRA_LOCAL_SCHEDULER=true          # in-process ticks for local dev; Cloud Scheduler in prod
TEPHRA_REGION=java_bali

# Optional layers
TEPHRA_SCIENCE=false                 # raw Himawari split-window (needs the [science] extra)
TEPHRA_VONA_LIVE=false               # MAGMA robots.txt disallows crawling; enable only with PVMBG permission
