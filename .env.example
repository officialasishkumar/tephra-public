# Copy to .env, then uncomment and fill in what you need. Names only; never commit real values.
# Defaults are those in tephra/config.py, and an empty value counts as unset.

# Gemini: a personal Google AI Studio key. Never a work account, never Vertex AI / ADC.
TEPHRA_LLM=stub                      # stub (offline, labelled NO MODEL) | gemini
# GEMINI_API_KEY=                    # needed only with TEPHRA_LLM=gemini
TEPHRA_MODEL=gemini-3.8-flash        # Plume Reader
TEPHRA_MODEL_LITE=gemini-3.5-flash-lite
TEPHRA_MODEL_DAILY_BUDGET=18         # free tier is reported at ~20 requests/day
TEPHRA_MODEL_LITE_DAILY_BUDGET=450
# TEPHRA_LLM_TIMEOUT_S=60

# Desk and scheduler auth. The secret and the token need 32+ characters: openssl rand -hex 32
# TEPHRA_DESK_PIN=                   # unset disables desk login
# TEPHRA_SESSION_SECRET=             # signs desk cookies; unset = random per process
# TEPHRA_DESK_SESSION_TTL_H=12
# TEPHRA_TASK_TOKEN=                 # X-Tephra-Task-Token for POST /tasks/tick; unset refuses all

# Storage: sqlite locally; firestore only inside Cloud Run (runtime service account)
TEPHRA_STORE=sqlite
# TEPHRA_GCP_PROJECT=                # firestore only
# TEPHRA_GCS_BUCKET=                 # firestore only
# TEPHRA_FIRESTORE_DATABASE=(default)
# Paths default to the repo (data/, .state/); a relative value is from the working directory.
# TEPHRA_DATA_DIR=data
# TEPHRA_CACHE_DIR=.state/cache
# TEPHRA_SQLITE_PATH=.state/tephra.sqlite3

# Run mode
TEPHRA_MODE=LIVE                     # LIVE | REPLAY
# TEPHRA_REPLAY_CASE=                # case id under data/replay/; unset = newest case
# TEPHRA_REPLAY_START=               # UTC, e.g. 2026-09-26T22:30:00Z (clamped into the case); unset = case start
# TEPHRA_REPLAY_SPEED=1.0
TEPHRA_AUTO_REPLAY=false
# TEPHRA_AUTO_REPLAY_AFTER_TICKS=3
TEPHRA_LOCAL_SCHEDULER=true          # in-process ticks for local dev; Cloud Scheduler in prod
# TEPHRA_TICK_INTERVAL_S=60
TEPHRA_REGION=java_bali              # java_bali | halmahera | kyushu

# Optional layers
TEPHRA_SCIENCE=false                 # raw Himawari split-window (needs the [science] extra)
TEPHRA_VONA_LIVE=false               # MAGMA robots.txt disallows crawling; enable only with PVMBG permission
TEPHRA_NICT_FRAMES=false             # NICT true colour: non-commercial terms; the Wall's GIBS layers replace it

# Reconciliation tolerances and activity rules
# TEPHRA_HEIGHT_TOLERANCE_FT=2000
# TEPHRA_DIRECTION_TOLERANCE_DEG=45
# TEPHRA_LAG_THRESHOLD_MIN=20
# TEPHRA_SILENCE_THRESHOLD_MIN=30
# TEPHRA_ACTIVE_RADIUS_KM=300
# TEPHRA_VONA_WINDOW_H=24

# Exposure
# TEPHRA_VERTICAL_MARGIN_FT=2000
# TEPHRA_EXPOSURE_LOOKAHEAD_MIN=60
# TEPHRA_DEFAULT_HORIZON_H=6
# TEPHRA_ADSB_RADIUS_NM=250
# TEPHRA_ALTERNATE_SEARCH_NM=400

# Feed cadences (seconds); a feed is stale after TEPHRA_STALE_FACTOR x its cadence
# TEPHRA_CADENCE_SIGMET_S=60
# TEPHRA_CADENCE_VONA_S=300
# TEPHRA_CADENCE_VAAC_S=300
# TEPHRA_CADENCE_FRAMES_S=600
# TEPHRA_CADENCE_HSD_S=600
# TEPHRA_CADENCE_WINDS_S=3600
# TEPHRA_CADENCE_TAF_S=1800
# TEPHRA_CADENCE_ADSB_S=30
# TEPHRA_STALE_FACTOR=3

# HTTP politeness
# TEPHRA_HTTP_TIMEOUT_S=20
# TEPHRA_HTTP_RETRIES=2
# TEPHRA_ADSB_MIN_INTERVAL_S=1.1

# Split-window BTD
# TEPHRA_BTD_BAND_PAIR=B13-B15       # B13-B15 | B14-B15
# TEPHRA_BTD_THRESHOLD_K=-0.5
# TEPHRA_BTD_HALF_WIDTH_KM=250

# Server
# PORT=8080                          # Cloud Run sets PORT; TEPHRA_PORT also works
# TEPHRA_LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR
# TEPHRA_MAX_EVENT_STREAMS=200       # open /api/events streams; keep below Cloud Run --concurrency
