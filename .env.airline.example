# TEPHRA for <name> (<ICAO>), made in the workspace on <YYYY-MM-DD>.
# Status on <origin>: <Pending verification | Verified | Declined>.
# Decision support only. Not for operational use without your safety risk assessment,
# your regulator's acceptance and, with Gemini, Google's written agreement for that use.
# Copy this file to .env in your TEPHRA folder. It holds secrets: never commit it.
#
# The shape of airline.env in the setup kit an onboarded airline downloads from its workspace
# (docs/ONBOARDING.md). Names and placeholders only; the kit fills in the values.
TEPHRA_MODE=LIVE
TEPHRA_AUTO_REPLAY=false
TEPHRA_REGION=<region>                 # the preset (java_bali | halmahera | kyushu) whose area holds your main base; outside all three the kit writes this line commented out: TEPHRA's live feeds cover only these
TEPHRA_FEATURES=connect                # connect: Desk > Data connections; add ,crew when you push pilot reports
TEPHRA_VISITOR_ACCESS=off
TEPHRA_RECOVERY_AUTO=false             # recovery re-planning for your network is not built
TEPHRA_VONA_LIVE=false
TEPHRA_STORE=sqlite
TEPHRA_LOCAL_SCHEDULER=true
TEPHRA_DESK_PIN=<pin>
TEPHRA_SESSION_SECRET=<session_secret>
TEPHRA_TASK_TOKEN=<task_token>
TEPHRA_FLEET_PREFIXES=<callsign prefix,extra prefixes>
TEPHRA_FLEET_HEXES=<hex,hex,...>       # left out when no aircraft has a hex
TEPHRA_NETWORK_AIRPORTS=<ICAO,...>     # your airports in TEPHRA's list; left out when none
TEPHRA_POLICY_FILE=policy/airline.json
# --- your airline: drafts, documents and the Wall name it and its flights ---
TEPHRA_AIRLINE_NAME="<name>"           # quoted; said in place of the fictional Ring of Fire Air
TEPHRA_AIRLINE_ICAO=<ICAO>             # your designator; callsigns starting with it are your flights
TEPHRA_AIRLINE_IATA=<IATA>             # left out when you have none
TEPHRA_AIRLINE_SCHEDULE=airline/flights.json   # the kit's flights.json, copied to data/airline/
TEPHRA_AIRLINE_FLEET=airline/fleet.json        # the kit's fleet.json (registrations and addresses)
# A flight of your fleet is named by its callsign when it is one of yours (a prefix above or
# your ICAO), else by the flight number of a pushed flight plan flying now, else by its flight
# in flights.json (by registration or callsign and time), else by its registration. Never by
# an RFA number.
# --- model ---
TEPHRA_LLM=<gemini | ollama | stub>    # stub: NO MODEL, code checks only
GEMINI_API_KEY=<key or empty>          # gemini only; empty: paste your own AI Studio key here (startup fails until you do)
TEPHRA_OLLAMA_URL=<url>                # ollama only
TEPHRA_MODEL=<model>                   # gemini or ollama
TEPHRA_MODEL_LITE=<model_lite>         # gemini or ollama
